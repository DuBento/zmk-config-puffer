/*
 * https://github.com/zmkfirmware/zmk/blob/main/app/include/dt-bindings/zmk/keys.h
 */

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/36.h"

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEF 0
#define NUM 1
#define NAV 2
#define SYS 3
#define MAC 4  // toggled on top of DEF; only swaps the editing combos Ctrl -> Cmd

#define BASE_LAYERS DEF MAC  // layers where "normal typing" combos are active

#define XXX &none
#define ___ &trans

#define QUICK_TAP_MS 175

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  /* left hand  */
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  /* right hand */
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      /* thumbs     */

// ---------- SETTINGS ----------

&lt {  // layer-tap config
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

// ----------- COMBOS -----------
#define COMBO_TERM    50
#define COMBO_IDLE_MS 150  // letter-pair combos only fire after a short typing pause

// Own combo macro so we can set require-prior-idle-ms (avoids false triggers while typing fast)
#define MAKE_COMBO(NAME, BINDINGS, KEYPOS, LAYERS, TERM_MS, IDLE_MS) \
    / { \
        combos { \
            compatible = "zmk,combos"; \
            combo_##NAME { \
                bindings = <BINDINGS>; \
                key-positions = <KEYPOS>; \
                layers = <LAYERS>; \
                timeout-ms = <TERM_MS>; \
                require-prior-idle-ms = <IDLE_MS>; \
            }; \
        }; \
    };

// left and right brace { }
MAKE_COMBO(lbrc, &kp LBRC, RT1 RT2, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)
MAKE_COMBO(rbrc, &kp RBRC, RT2 RT3, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)

// left and right parenthesis ( )
MAKE_COMBO(lpar, &kp LPAR, RM1 RM2, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)
MAKE_COMBO(rpar, &kp RPAR, RM2 RM3, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)

// left and right bracket [ ]
MAKE_COMBO(lbkt, &kp LBKT, RB1 RB2, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)
MAKE_COMBO(rbkt, &kp RBKT, RB2 RB3, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)

// less-than and greater-than < >
MAKE_COMBO(lt, &kp LT, LT3 LT2, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)
MAKE_COMBO(gt, &kp GT, LT2 LT1, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)

// underscore and equal
MAKE_COMBO(under, &kp UNDER, LM3 LM2, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)
MAKE_COMBO(equal, &kp EQUAL, LM2 LM1, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)

// minus and plus
MAKE_COMBO(minus, &kp MINUS, LB3 LB2, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)
MAKE_COMBO(plus,  &kp PLUS,  LB2 LB1, BASE_LAYERS, COMBO_TERM, COMBO_IDLE_MS)

// apostrophe on H+J (never typed together in English, so no idle guard needed:
// it must work mid-word, e.g. don't)
MAKE_COMBO(squot, &kp SINGLE_QUOTE, RM0 RM1, BASE_LAYERS, COMBO_TERM, 0)

// caps word on both index-finger home keys (F + J)
MAKE_COMBO(capsword, &caps_word, LM3 RM1, BASE_LAYERS, COMBO_TERM, 0)

// editing combos: Ctrl on Linux (DEF), Cmd on macOS (MAC)
#define MAKE_EDIT_COMBO(NAME, KEY, POS) \
    MAKE_COMBO(NAME, &kp LC(KEY), POS, DEF, COMBO_TERM, 0) \
    MAKE_COMBO(NAME##_mac, &kp LG(KEY), POS, MAC, COMBO_TERM, 0)

MAKE_EDIT_COMBO(copy,  C, LM2 LT2)  // D + E
MAKE_EDIT_COMBO(paste, V, LM1 LT1)  // S + W
MAKE_EDIT_COMBO(cut,   X, LM1 LB1)  // S + X
MAKE_EDIT_COMBO(undo,  Z, LM0 LB0)  // A + Z

// ----------- KEYMAP -----------

// reuse basic mod-morph scheme
#define MAKE_SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2) \
    ZMK_MOD_MORPH(NAME, \
        mods = <(MOD_L ## MOD|MOD_R ## MOD)>; \
        bindings = <BINDING1>, <BINDING2>; \
    )

// tap: space | shift + tap: tab
MAKE_SIMPLE_MORPH(spc_tab, SFT, &kp SPACE, &kp TAB)

// Hold: layer | Tap: custom behavior (mod-morph)
#define MAKE_LT_MORPH(NAME, TAP_BEHAVIOR) \
    ZMK_HOLD_TAP(NAME, \
        flavor = "balanced"; \
        tapping-term-ms = <200>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        bindings = <&mo>, <TAP_BEHAVIOR>; \
    )

MAKE_LT_MORPH(lt_num_spctab, &spc_tab)

// tap: semicolon | shift + tap: colon
MAKE_SIMPLE_MORPH(semi_colon, SFT, &kp SEMI, &kp COLON)

// tap: slash | shift + tap: question mark
MAKE_SIMPLE_MORPH(slash_qmark, SFT, &kp SLASH, &kp QMARK)

// tap: comma | shift + tap: double quotes
MAKE_SIMPLE_MORPH(comma_dquot, SFT, &kp COMMA, &kp DOUBLE_QUOTES)

// tap: dot | shift + tap: single quotes
MAKE_SIMPLE_MORPH(dot_squot, SFT, &kp DOT, &kp SINGLE_QUOTE)

// tap: plus | shift + tap: equal
MAKE_SIMPLE_MORPH(plus_equal, SFT, &kp PLUS, &kp EQUAL)

// tap: ESC | shift + tap: tilde
MAKE_SIMPLE_MORPH(esc_tilde, SFT, &kp ESC, &kp TILDE)

// tap: DEL | ctrl + tap: caps word
MAKE_SIMPLE_MORPH(del_caps, CTL, &kp DEL, &caps_word)

// For mod tap
#define MAKE_MOD_TAP(NAME, BINDING1, BINDING2) \
    ZMK_HOLD_TAP(NAME, \
        flavor = "hold-preferred"; \
        tapping-term-ms = <200>; \
        bindings = <BINDING1>, <BINDING2>; \
    )

MAKE_MOD_TAP(mod_esctil, &kp , &esc_tilde)
MAKE_MOD_TAP(mod_delcaps, &kp, &del_caps)

// double-tap to enter bootloader
ZMK_TAP_DANCE(boot,
    bindings = <&none>, <&bootloader>;
)

// Cross-hand only home row mods
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )
MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  // left-hand HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  // right-hand HRMs
MAKE_HRM(hmr_sc, &kp, &semi_colon, KEYS_L THUMBS)  

ZMK_CONDITIONAL_LAYER(sys_condition, NUM NAV, SYS)


ZMK_LAYER(Qwerty,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
      &kp Q           &kp W         &kp E          &kp R        &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &hml LALT A   &hml LGUI S  &hml LCTRL D   &hml LSHFT F     &kp G             &kp H     &hmr RSHFT J  &hmr RCTRL K   &hmr RGUI L   &hmr_sc RALT 0
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp Z        &kp X         &kp C         &kp V         &kp B             &kp N         &kp M       &comma_dquot   &dot_squot   &slash_qmark
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                            &mod_esctil LGUI 0 &mt LCTRL TAB &lt_num_spctab NUM 0      &lt NAV BSPC &mt RSHFT ENTER &mod_delcaps RALT 0
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(Numpad,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp EXCL      &kp AT        &kp HASH     &kp DLLR       &kp PRCNT       &kp CARET      &kp AMPS     &kp KP_MULTIPLY &kp LPAR    &kp RPAR
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &hml LALT N1  &hml LGUI N2  &hml LCTRL N3 &hml LSHFT N4     &kp N5          &kp N6      &hmr RSHFT N7 &hmr RCTRL N8  &hmr RGUI N9  &hmr LALT N0
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp GRAVE     &kp TILDE   &kp MINUS     &kp EQUAL     &kp UNDER         &kp PLUS       &kp LT         &kp GT     &kp BACKSLASH   &kp PIPE 
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                     ___           ___           ___               ___           ___          ___
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(Nav,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       &kp ESC     &kp LC(PG_UP) &kp LC(PG_DN)     XXX          XXX            &kp C_VOL_UP    &kp HOME       &kp UP       &kp END      &kp PG_UP
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp LALT      &kp LGUI      &kp LCTRL     &kp LSHFT  &key_repeat         &kp C_VOL_DN    &kp LEFT       &kp DOWN     &kp RIGHT    &kp PG_DN
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       XXX          XXX             XXX            XXX          XXX            &kp K_MUTE      &kp C_PP      &kp C_PREV    &kp C_NEXT      XXX          
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                     ___           ___          ___               ___           ___           ___
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(System,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &kp C_BRI_INC    &kp F7         &kp F8       &kp F9        &kp F12
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        &kp LALT      &kp LGUI      &kp LCTRL     &kp LSHFT       XXX         &kp C_BRI_DEC    &kp F4         &kp F5       &kp F6        &kp F11
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &bt BT_CLR       &boot       &tog MAC          XXX           XXX               XXX         &kp F1         &kp F2       &kp F3      &kp F10
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                     ___           ___           ___               ___           ___           ___
//                             ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

// Empty layer: toggled from the System layer. Its only job is to make the
// editing combos send Cmd instead of Ctrl (see MAKE_EDIT_COMBO).
ZMK_LAYER(Mac,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        ___           ___           ___           ___           ___               ___           ___           ___           ___           ___
